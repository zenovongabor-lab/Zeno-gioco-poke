# Copy this file to ".env" and fill in your key.
# Get a key at https://console.anthropic.com/  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which model the bot's "brain" uses. Sonnet is the best cost/quality balance
# for a fast game-playing loop. Opus is smarter but slower and pricier.
BOT_MODEL=claude-sonnet-5

# Part of the game window's title bar text (case-insensitive). The bot finds
# the game by matching this. "Hydro Bliss" usually works; if not, look at the
# exact title of the game window and put a distinctive word from it here.
GAME_WINDOW_TITLE=Hydro Bliss

# Seconds to wait after each batch of button presses before looking again.
# Higher = calmer, cheaper, fewer API calls. Lower = more reactive.
STEP_DELAY=1.2
